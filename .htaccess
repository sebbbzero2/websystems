RewriteEngine On
RewriteBase /

# If the request is for a real file or directory inside public/, serve it directly
RewriteCond %{REQUEST_URI} !^/public/ [NC]
RewriteCond %{DOCUMENT_ROOT}/public%{REQUEST_URI} -f [OR]
RewriteCond %{DOCUMENT_ROOT}/public%{REQUEST_URI} -d
RewriteRule ^(.*)$ public/$1 [L,QSA]

# Send all other requests to the public folder (for CI4 routing)
RewriteCond %{REQUEST_URI} !^/public/ [NC]
RewriteRule ^(.*)$ public/$1 [L,QSA]

# Default index file
DirectoryIndex index.php
